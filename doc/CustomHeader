CustomHeader(
  title: "Moka Mola",
  subtitle: "CAFE",
  activeTable: "Table 5",
  totalItemCount: 3,
  primaryColor: Colors.brown,
  accentColor: Colors.amber,
  badgeColor: Colors.red,
  onMenuTap: () {
    print("Menu tapped");
  },
  onQrTap: () {
    print("QR scanner tapped");
  },
  onNotificationTap: () {
    print("Notification bell tapped");
  },
  onCartTap: () {
